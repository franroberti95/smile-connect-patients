# Copy this file to .env.local and fill in the real values.

# URL of the smile-connect API that serves the patient portal
NEXT_PUBLIC_SMILE_CONNECT_API_URL=http://localhost:3000

# Optional: public domain of this patient portal (used for absolute links)
NEXT_PUBLIC_PATIENT_PORTAL_URL=http://localhost:3001

# Firebase public config (same project as smile-connect auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
